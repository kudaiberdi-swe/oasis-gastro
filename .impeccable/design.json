    },
    {
      "name": "Office Navigation Item",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Dark sidebar; the active item is raised, gold, with a 2px gold bar.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\">Остатки</a><a class=\"ds-nav-item ds-nav-item-active\" href=\"#\" aria-current=\"page\">Номенклатура</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:240px;padding:8px;background:var(--nav,#121316)}.ds-nav-item{position:relative;display:flex;align-items:center;min-height:36px;padding:6px 8px 6px 36px;border-radius:var(--radius-control,2px);color:var(--nav-muted,#bfb5a8);font:400 14px/20px 'Golos Text',Arial,sans-serif;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav-item:hover{background:var(--nav-raised,#1e1e1e);color:var(--nav-foreground,#fff7ec)}.ds-nav-item-active{background:var(--nav-raised,#1e1e1e);color:var(--nav-accent,#b28f6f);font-weight:600}.ds-nav-item-active::before{content:'';position:absolute;top:4px;bottom:4px;left:0;width:2px;background:var(--gold,#b28f6f)}.ds-nav-item:focus-visible{outline:2px solid var(--nav-accent,#b28f6f);outline-offset:2px}"
    },
