      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one wine main action of a screen.",
      "html": "<button class=\"ds-btn-primary\">Оплатить</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border:0;border-radius:var(--radius-control,2px);background:var(--primary,#8c2323);color:var(--primary-foreground,#fff);font:600 14px/20px 'Golos Text',Arial,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:var(--primary-hover,#6e1b1b)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring,#7f5c43);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every other action: white with a clay border.",
      "html": "<button class=\"ds-btn-secondary\">Сохранить черновик</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:44px;padding:0 16px;border:1px solid var(--input,#8c8173);border-radius:var(--radius-control,2px);background:var(--card,#fff);color:var(--foreground,#121316);font:600 14px/20px 'Golos Text',Arial,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-secondary:hover{background:var(--muted,#f5ecdf)}.ds-btn-secondary:focus-visible{outline:2px solid var(--ring,#7f5c43);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action, confirmed in a dialog.",
      "html": "<button class=\"ds-btn-danger\">Отменить заказ</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;height:44px;padding:0 16px;border:1px solid var(--destructive,#b42318);border-radius:var(--radius-control,2px);background:var(--card,#fff);color:var(--destructive,#b42318);font:600 14px/20px 'Golos Text',Arial,sans-serif;cursor:pointer}.ds-btn-danger:hover{background:var(--muted,#f5ecdf)}.ds-btn-danger:focus-visible{outline:2px solid var(--ring,#7f5c43);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Text field: white, clay border, carved corners.",
      "html": "<input class=\"ds-input\" placeholder=\"Название, описание или артикул\">",
      "css": ".ds-input{height:44px;width:280px;padding:0 12px;border:1px solid var(--input,#8c8173);border-radius:var(--radius-control,2px);background:var(--card,#fff);color:var(--foreground,#121316);font:400 14px/20px 'Golos Text',Arial,sans-serif}.ds-input::placeholder{color:var(--muted-foreground,#6b6159)}.ds-input:focus-visible{outline:2px solid var(--ring,#7f5c43);outline-offset:2px}.ds-input[aria-invalid=true]{border-color:var(--destructive,#b42318)}"
    },
    {
      "name": "Status Pill",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "A status as a 10% tint with a 30% border.",
      "html": "<span class=\"ds-pill ds-pill-success\">Оплачен</span> <span class=\"ds-pill\">Черновик</span>",
