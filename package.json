{
  "name": "sandyq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p convex --pretty false",
    "convex:check": "convex dev --once --typecheck enable",
    "seed": "node scripts/seed-sandyq.mjs",
    "iiko:discover": "node --env-file=.env scripts/iiko/extract.mjs --discover-only",
    "iiko:extract": "node --env-file=.env scripts/iiko/extract.mjs",
    "iiko:import": "node --env-file=.env scripts/iiko/import-convex.mjs",
    "iiko:reconcile": "node --env-file=.env scripts/iiko/reconcile.mjs",
    "iiko:seed": "node --env-file=.env scripts/iiko/seed.mjs",
    "guards": "node scripts/check-guards.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "e2e": "playwright test",
    "e2e:screens": "SCREENS=1 playwright test e2e/screens && node scripts/compare-screens.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "test:credentials": "node scripts/test-credentials.mjs",
    "video:capture": "VIDEO=1 bash scripts/e2e-pos.sh e2e/video --project=pos-1440-day --project=pos-1440-night --workers=1; SCREENS=1 npx playwright test e2e/screens --project=office-1440-day --project=office-1440-night --reporter=line",
    "lint:convex": "node scripts/check-unbounded-queries.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@fontsource/cormorant": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.43.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.55",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
